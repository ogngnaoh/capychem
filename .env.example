# Optional settings for the legacy benchmark app. Studio's scripts/dev.py
# configures the local database and worker automatically.
CAPYCHEM_HARNESS_PYTHON=harness/.venv/bin/python
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# Local development credentials used by infra/compose.yml.
POSTGRES_USER=capychem
POSTGRES_PASSWORD=capychem
POSTGRES_DB=capychem
CAPYCHEM_DATABASE_URL=postgresql+asyncpg://capychem:capychem@localhost:5432/capychem

# The default benchmark proposer and analyzer are deterministic and key-free.
# For a network-backed proposer, set the backend to direct and supply a key.
CAPYCHEM_PROPOSER_BACKEND=stub
# DEEPSEEK_API_KEY=
# CAPYCHEM_LLM_MODEL=
# CAPYCHEM_ANALYZER_BACKEND=direct
# CAPYCHEM_ORACLE_BACKEND=local
# CAPYCHEM_COST_CAP_USD=50.0

# Optional trace collection and links for the benchmark app.
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PROJECT_ID=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
