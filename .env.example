# Copy to .env.local (gitignored) and adjust. Dev defaults only — never commit real secrets.

# Path to the isolated harness interpreter used by the subprocess oracle bridge.
CAPYCHEM_HARNESS_PYTHON=harness/.venv/bin/python

# Frontend → backend (absolute URL; do not proxy through Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres (infra/compose.yml) — run state. Local dev credentials.
POSTGRES_USER=capychem
POSTGRES_PASSWORD=capychem
POSTGRES_DB=capychem
CAPYCHEM_DATABASE_URL=postgresql+asyncpg://capychem:capychem@localhost:5432/capychem

# Langfuse (infra/langfuse-compose.yml) — wired in slice 2 when spans are emitted.
